# Copy this file to ".env" and fill in your real key(s).
# Get a free Etherscan key at https://etherscan.io/myapikey
# Get a free TronGrid key at https://www.trongrid.io/

# Etherscan v2 API key (required for Ethereum, BSC, Polygon traces)
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY_HERE"

# TronGrid API key (optional — works without a key but with lower rate limits)
TRONGRID_API_KEY="YOUR_TRONGRID_API_KEY_HERE"

# How many hops outward the tracer walks before giving up (higher = slower, more thorough)
MAX_HOPS=3

# Max transactions fetched per wallet per API call (Etherscan free tier allows up to 10000,
# but keep this modest during a live demo to stay fast and within rate limits)
MAX_TX_PER_WALLET=200